# ============================================================================
#  BACKEND · .env de PRODUCCIÓN (VPS DigitalOcean)
#  Copia este archivo como  server/.env  en el VPS y completa los valores.
#  NO subas el .env real al repo (ya está en .gitignore).
#  Permisos recomendados en el VPS:  chmod 600 server/.env
# ============================================================================

# ─────────── OBLIGATORIAS ───────────

# MongoDB Atlas. SE MANTIENE EN ATLAS (no se migra al VPS).
# Copia el MISMO valor que ya usas en Render. Recuerda permitir la IP pública
# del VPS en Atlas > Network Access antes de arrancar.
MONGODB_URI=

# JWT. COPIA EL MISMO VALOR QUE EN RENDER.
# Si lo cambias, todas las sesiones activas se invalidan (los usuarios deberán
# volver a iniciar sesión). No es bloqueante, pero conviene reutilizarlo.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Puerto local donde escucha Node detrás de Nginx. 5000 es el valor por defecto.
PORT=5000

# Origenes permitidos por CORS (sin barra final). En producción debe ser el
# dominio del frontend servido por Nginx. Separa varios con coma.
# Ej: https://app.tudominio.com,https://www.tudominio.com
ALLOWED_ORIGINS=https://app.tudominio.com

# Cifrado de la contraseña del certificado P12 (facturación electrónica SRI).
# CRÍTICO: COPIA EL MISMO VALOR QUE EN RENDER. Si cambia, las contraseñas de
# los certificados ya guardados quedan ILEGIBLES y se rompe la facturación.
INVOICE_ENCRYPTION_KEY=

# ─────────── MARKETING / CRM / WHATSAPP ───────────

# URL pública del backend + /api. En el VPS apunta a tu dominio real con HTTPS.
# Necesaria para: URL de webhooks que se muestran al admin, imágenes/cabeceras
# de plantillas, enlaces de reseña/baja/tracking. SIN barra final.
# Ej: https://api.tudominio.com/api   (o https://app.tudominio.com/api)
PUBLIC_API_URL=https://api.tudominio.com/api

# Cifrado en reposo de tokens/secrets de WhatsApp Cloud API (Access Token, App
# Secret, etc.). 32 bytes en hex (64 chars) o base64 de 32 bytes.
# CRÍTICO: COPIA EL MISMO VALOR QUE EN RENDER. Si cambia, los tokens cifrados
# quedan ilegibles y hay que reconfigurar los canales de WhatsApp/Meta.
# Si en Render NO existe, los tokens estaban en texto plano: defínela ahora y
# vuelve a guardar los tokens desde la app para cifrarlos.
SECRETS_KEY=

# Token de verificación del webhook único de WhatsApp Cloud API (handshake GET
# con Meta). Debe coincidir con el configurado en Meta for Developers.
WHATSAPP_VERIFY_TOKEN=

# (Opcional) Versión de la Graph API de Meta/WhatsApp. Por defecto v20.0.
# WHATSAPP_API_VERSION=v20.0

# (Opcional) Cada cuántos minutos se sondea Meta el estado de las plantillas.
# Mínimo 5, por defecto 60.
# TEMPLATE_SYNC_INTERVAL_MIN=60

# ─────────── IA (asistente de respuestas / resúmenes) ───────────

# Clave de la API de Anthropic (Claude). Si no se define, las funciones de IA
# del call center quedan deshabilitadas (el resto del sistema funciona igual).
ANTHROPIC_API_KEY=
# (Opcional) Modelo a usar.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# ─────────── WHATSAPP POR QR (whatsapp-web.js) ───────────

# Ruta al ejecutable de Chromium del sistema en el VPS. Recomendado en Linux
# para no depender del Chromium que descarga Puppeteer.
# En Ubuntu, tras instalar chromium-browser:  which chromium-browser
# Ej: /usr/bin/chromium-browser  o  /usr/bin/google-chrome
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ─────────── SOLO PARA EL SCRIPT create-superadmin.js (opcional) ───────────
# Úsalas puntualmente al crear el primer superadmin; no son del runtime.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
