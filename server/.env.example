# Copia este archivo como .env y completa los valores

# MongoDB Atlas (obtén la URI desde Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/clinica_db?retryWrites=true&w=majority

# JWT (genera uno aleatorio largo: openssl rand -hex 64)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# Puerto (Render lo asigna automáticamente via $PORT, no es necesario fijarlo)
PORT=5000

# Origins permitidos (URL de tu frontend en Vercel, sin trailing slash)
# Si tienes más de uno, sepáralos con comas
ALLOWED_ORIGINS=https://tu-proyecto.vercel.app

# Clave para cifrar la contraseña del certificado P12 (mínimo 16 caracteres, generar aleatoria)
# openssl rand -hex 32
INVOICE_ENCRYPTION_KEY=cambia_esto_por_una_clave_aleatoria_larga

# ─────────── Marketing / CRM / WhatsApp (Meta) ───────────

# URL pública del backend + /api (en Render: https://tu-servicio.onrender.com/api).
# Necesaria para: URL del webhook que se muestra en la config, imágenes/cabeceras
# de plantillas, y enlaces de reseña/baja/tracking de email. SIN trailing slash.
PUBLIC_API_URL=https://tu-servicio.onrender.com/api

# Cifrado en reposo de tokens/secrets (Access Token de WhatsApp, App Secret, etc.).
# 32 bytes en hex (64 chars). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: defínela UNA vez y no la cambies, o los secretos cifrados quedarán ilegibles.
SECRETS_KEY=

# (Opcional) Versión de la Graph API de WhatsApp. Por defecto v20.0.
# WHATSAPP_API_VERSION=v20.0

# (Opcional) Cada cuántos minutos se sondea Meta el estado/categoría de las
# plantillas (red de seguridad; el webhook avisa al instante). Mínimo 5, por defecto 60.
# TEMPLATE_SYNC_INTERVAL_MIN=60
